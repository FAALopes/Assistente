generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  MICROSOFT
  GMAIL
  IMAP
}

enum RuleField {
  FROM
  SUBJECT
  BODY
}

enum RuleOperator {
  CONTAINS
  EQUALS
  STARTS_WITH
}

enum RuleAction {
  DELETE
  TODO
  SAVE_LATER
  SAVE_ONEDRIVE
}

enum TriageAction {
  DELETE
  MOVE_TO_INBOX
  REVIEW
}

model EmailAccount {
  id           String    @id @default(uuid())
  email        String
  displayName  String?
  color        String?
  provider     Provider
  accessToken  String    @default("")
  refreshToken String?
  tokenExpiry  DateTime?
  userId       String?
  imapHost         String?
  imapPort         Int?
  imapUser         String?
  imapPasswordEnc  String?
  imapTls          Boolean @default(true)
  sortOrder    Int       @default(0)
  globalDeltaLink  String?  // Microsoft Graph /me/messages/delta link
  autoSyncMinutes Int?     // null = off; otherwise minimum minutes between auto syncs
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  emails       Email[]
  folders      MailFolder[]

  @@map("email_accounts")
}

model MailFolder {
  accountId      String
  account        EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  id             String   // Graph folder id or IMAP path (unique per account)
  displayName    String
  parentId       String?
  path           String   // slash-joined ancestors + displayName
  depth          Int      @default(0)
  wellKnownName  String?  // inbox, junkemail, sentitems, drafts, deleteditems, archive, outbox, conversationhistory, ...
  totalItemCount Int      @default(0)
  unreadItemCount Int     @default(0)
  deltaLink      String?  // (legacy per-folder MS delta; superseded by EmailAccount.globalDeltaLink)
  lastUid        Int?     // IMAP: last UID fetched in this folder
  uidValidity    BigInt?  // IMAP: UIDVALIDITY; change forces full re-fetch
  lastSyncAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([accountId, id])
  @@index([accountId])
  @@index([accountId, path])
  @@map("mail_folders")
}

model SyncJob {
  id            String   @id @default(uuid())
  accountId     String?
  status        String   // queued | running | done | error
  phase         String?  // folders | emails | cleanup
  currentFolder String?
  currentAccount String?
  accountsTotal Int      @default(0)
  accountsDone  Int      @default(0)
  foldersTotal  Int      @default(0)
  foldersDone   Int      @default(0)
  emailsSynced  Int      @default(0)
  emailsRemoved Int      @default(0)
  errors        Json?
  accountsProgress Json? // per account: { email, done, total, folder, status }
  startedAt     DateTime @default(now())
  finishedAt    DateTime?

  @@index([status])
  @@index([startedAt])
  @@map("sync_jobs")
}

model Email {
  id             String        @id @default(uuid())
  externalId     String        @unique
  accountId      String
  account        EmailAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  from           String
  to             String?
  subject        String?
  bodyPreview    String?
  folder         String        @default("inbox")
  receivedAt     DateTime
  isRead         Boolean       @default(false)
  importance     String?
  hasAttachments Boolean       @default(false)
  category       String        @default("UNCATEGORIZED") // Category.key (built-in or custom)
  categorySetAt  DateTime?
  triageAction   TriageAction?
  triageReason   String?
  triageConfidence Int?
  triageClassifiedAt DateTime?
  createdAt      DateTime      @default(now())

  @@index([accountId])
  @@index([category])
  @@index([receivedAt])
  @@index([folder])
  @@map("emails")
}

// User-defined categories + overrides (name/color/order) of the built-in ones.
// Built-in keys live in src/services/categories.ts; a row here with the same key overrides them.
model Category {
  key       String   @id
  name      String
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model TriageOverride {
  id            String       @id @default(uuid())
  senderAddress String
  senderDomain  String
  subjectPattern String?
  aiDecision    TriageAction
  userDecision  TriageAction
  occurrences   Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([senderAddress, userDecision])
  @@index([senderDomain])
  @@map("triage_overrides")
}

model Rule {
  id           String       @id @default(uuid())
  field        RuleField
  operator     RuleOperator
  value        String
  action       RuleAction
  confidence   Int          @default(100)
  timesApplied Int          @default(0)
  createdAt    DateTime     @default(now())

  @@map("rules")
}

model AppConfig {
  id                   String   @id @default("singleton")
  azureClientSecret    String?
  azureClientSecretUpdatedAt DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("app_config")
}

model EmailAction {
  id              String   @id @default(uuid())
  name            String
  accountId       String?
  senderPattern   String?
  subjectPattern  String?
  actionType      String   @default("OPEN_URL")
  actionValue     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
  @@map("email_actions")
}

model ArchiveEntity {
  id        String   @id @default(uuid())
  name      String   @unique
  aliases   String[] @default([])
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     ArchiveItem[]
  rules     ArchiveRule[]

  @@map("archive_entities")
}

model ArchiveItem {
  id            String   @id @default(uuid())
  accountId     String   // MS account whose OneDrive hosts the file
  driveItemId   String
  name          String
  path          String   // full path relative to /Assistente
  isFolder      Boolean  @default(false)
  size          BigInt?
  mimeType      String?
  entityId      String?
  entity        ArchiveEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  tags          String[] @default([])
  notes         String?
  expiresAt     DateTime?
  sourceEmailId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([accountId, driveItemId])
  @@index([accountId])
  @@index([entityId])
  @@index([path])
  @@index([name])
  @@map("archive_items")
}

model ArchiveRule {
  id              String   @id @default(uuid())
  name            String
  accountId       String?  // null = all accounts
  senderPattern   String?  // substring match on from
  subjectPattern  String?  // substring match on subject
  attachmentOnly  Boolean  @default(true)  // only trigger for emails with attachments
  targetFolder    String   // path under /Assistente, e.g. "Faturas/Indaqua"
  filenamePattern String?  // tokens: {date}, {entity}, {subject}, {original}, {ext}
  entityId        String?
  entity          ArchiveEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  enabled         Boolean  @default(true)
  timesApplied    Int      @default(0)
  lastAppliedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
  @@map("archive_rules")
}

model RuleApplication {
  id               String        @id @default(uuid())
  emailId          String
  ruleId           String
  previousCategory String
  newCategory      String
  appliedAt        DateTime      @default(now())
  reverted         Boolean       @default(false)
  revertedAt       DateTime?
  acknowledgedAt   DateTime?

  @@index([acknowledgedAt])
  @@index([appliedAt])
  @@map("rule_applications")
}
